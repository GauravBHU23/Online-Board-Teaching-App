# Copy to .env for local use, or set these in your host's dashboard.
# Never commit the real .env — it is gitignored.

# Shared password for the whole instance. Leave empty to disable the login
# gate entirely (fine locally, NOT fine on a public URL).
BOARD_PASSWORD=

# Signs session cookies. Keep it stable so logins survive restarts.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where boards are stored. Point this at a mounted disk in production.
DATA_DIR=./data

# How long a login lasts.
SESSION_TTL_DAYS=30

# Enables secure cookies, same-origin sockets and proxy trust.
NODE_ENV=development

PORT=3000
